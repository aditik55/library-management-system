# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/libraryDB?retryWrites=true&w=majority
DB_NAME=libraryDB

# CORS - Frontend URL. Use the Vite dev server locally, or your Netlify URL in production.
FRONTEND_URL=http://localhost:5173
